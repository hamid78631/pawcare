# Copier ce fichier en .env puis renseigner la clé : cp .env.example .env
# Le fichier .env est ignoré par Git : ne jamais y versionner de vraie clé.

# Clé API Groq (https://console.groq.com/keys) — commence par gsk_
GROQ_API_KEY=

# API compatible OpenAI de Groq
BASE_URL_GROQ=https://api.groq.com/openai/v1

# Modèle utilisé par Pawly
GROQ_MODEL=openai/gpt-oss-20b

# Origines autorisées à appeler l'API (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173
